# Configure these variables in your hosting control panel or process manager.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_HOURS=8

